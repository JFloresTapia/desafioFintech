# Puerto del servidor HTTP
PORT=3000

# Secreto para firmar los JWT (mínimo 16 caracteres). Cambiar en producción.
JWT_SECRET=super-secret-jwt-change-me-2026

# Expiración del token (formato jsonwebtoken: "15m", "1h", "7d")
JWT_EXPIRES_IN=1h

# Entorno: development | test | production
NODE_ENV=development

# Origen permitido por CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173